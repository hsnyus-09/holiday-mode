{
  "name": "holiday-mode",
  "version": "0.1.0",
  "description": "Framework-independent seasonal DOM effects for Korean holidays.",
  "type": "module",
  "license": "MIT",
  "author": "Chuseok project contributors",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/holiday-mode.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/holiday-mode.js",
  "module": "./dist/holiday-mode.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "preview": "vite preview --config vite.demo.config.ts --host 127.0.0.1 --port 5175",
    "prepack": "npm run build:lib",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e && npm audit --audit-level=high"
  },
  "keywords": [
    "chuseok",
    "seollal",
    "holiday",
    "dom-effects",
    "typescript"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.63.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
